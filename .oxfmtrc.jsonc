{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "singleQuote": true,
  "printWidth": 70,
  "ignorePatterns": [
    // Dev
    "lib/**/*",
    "bench/micro/**/*.js",
    "bench/micro/quickjs/**/*",
    "bench/micro/llrt/**/*",

    // Other file types
    "**/*.json",
    "**/*.jsonc",
    "**/*.md",
    "**/bun.lock",
  ],
}
